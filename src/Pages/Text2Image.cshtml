@page
@{
    ViewData["Title"] = "Page is loading...";
    GeneratePageModel pageModel = new(HttpContext);
    string doCheckForUpdates = Program.ServerSettings.Maintenance.CheckForUpdates ? "true" : "false";
}
@section Header {
    <link rel="stylesheet" href="css/genpage.css?vary=@Utilities.VaryID" />
    <link rel="stylesheet" href="css/legacy-linear.css?vary=@Utilities.VaryID" />
}

@if (!Program.ServerSettings.IsInstalled)
{
    <script>
        window.location.href = "Install";
    </script>
    return;
}
@if (pageModel.IsLoginEnabled && pageModel.User is null)
{
    <script>
        window.location.href = "Login";
    </script>
    return;
}
<script>
    window.alwaysRefreshOnLoad = @pageModel.AlwaysRefreshOnLoad;
    window.instanceTitle = "@pageModel.InstanceTitle";
    window.comfy_features = {};
    window.checkForUpdatesAutomatically = @doCheckForUpdates;
    @foreach (InstallableFeatures.ComfyInstallableFeature feature in InstallableFeatures.ComfyFeatures.Values)
    {
        <text>
            window.comfy_features["@feature.ID"] = {
                "display_name": "@feature.DisplayName",
                "id": "@feature.ID",
                "url": "@feature.URL",
                "author": "@feature.Author",
                "notice": "@(new HtmlString(Utilities.EscapeJsonString(feature.Notice)))"
            };
        </text>
    }
</script>

<div class="legacy-page">
    <header class="legacy-header">
        <div class="legacy-brand">
            <h1 class="legacy-title">@pageModel.InstanceTitle</h1>
            <p class="legacy-subtitle">Simple, linear layout. Scroll to each section.</p>
        </div>
        <nav class="legacy-nav-wrapper">
            <ul class="legacy-nav" role="list" id="toptablist">
                <li role="presentation" data-requiredpermission="comfy_dynamic_custom_workflows,simple_tab">
                    <a class="legacy-nav-link translate" href="#Simple" id="simpletabbutton">Simple</a>
                </li>
                <li role="presentation">
                    <a class="legacy-nav-link translate" href="#Text2Image" id="text2imagetabbutton">Generate</a>
                </li>
                @WebServer.T2ITabHeader
                <li role="presentation" data-requiredpermission="utilities_tab">
                    <a class="legacy-nav-link translate" href="#utilities_tab" id="utilitiestabbutton">Utilities</a>
                </li>
                <li role="presentation" data-requiredpermission="user_tab">
                    <a class="legacy-nav-link translate" href="#user_tab" id="usersettingstabbutton">User</a>
                </li>
                <li role="presentation" data-requiredpermission="view_server_tab">
                    <a class="legacy-nav-link translate" href="#server_tab" id="servertabbutton">Server</a>
                </li>
            </ul>
        </nav>
    </header>

    <main class="legacy-main tab-content">
        <section class="legacy-section tab-pane tab-pane-vw" id="Simple" role="region" aria-labelledby="simpletabbutton">
            <h2 class="legacy-section-title">Simple</h2>
            @await Html.PartialAsync("_Generate/SimpleTab.cshtml", pageModel)
        </section>
        <section class="legacy-section tab-pane tab-pane-vw" id="Text2Image" role="region" aria-labelledby="text2imagetabbutton">
            <h2 class="legacy-section-title">Generate</h2>
            @await Html.PartialAsync("_Generate/GenerateTab.cshtml", pageModel)
        </section>
        @WebServer.T2ITabBody
        <section class="legacy-section tab-pane tab-pane-vw tab-no-scroll" id="utilities_tab" role="region" aria-labelledby="utilitiestabbutton">
            <h2 class="legacy-section-title">Utilities</h2>
            @await Html.PartialAsync("_Generate/UtilitiesTab.cshtml", pageModel)
        </section>
        <section class="legacy-section tab-pane tab-pane-vw tab-no-scroll" id="user_tab" role="region" aria-labelledby="usersettingstabbutton">
            <h2 class="legacy-section-title">User</h2>
            @await Html.PartialAsync("_Generate/UserTab.cshtml", pageModel)
        </section>
        <section class="legacy-section tab-pane tab-pane-vw tab-no-scroll" id="server_tab" role="region" aria-labelledby="servertabbutton">
            <h2 class="legacy-section-title">Server</h2>
            @await Html.PartialAsync("_Generate/ServerTab.cshtml", pageModel)
        </section>
    </main>
</div>

