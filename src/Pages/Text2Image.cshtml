@page
@{
    ViewData["Title"] = "Page is loading...";
    GeneratePageModel pageModel = new(HttpContext);
    string doCheckForUpdates = Program.ServerSettings.Maintenance.CheckForUpdates ? "true" : "false";
}
@section Header {
    <link rel="stylesheet" href="css/genpage.css?vary=@Utilities.VaryID" />
    <link rel="stylesheet" href="css/legacy.css?vary=@Utilities.VaryID" />
}

@if (!Program.ServerSettings.IsInstalled)
{
    <script>
        window.location.href = "Install";
    </script>
    return;
}
@if (pageModel.IsLoginEnabled && pageModel.User is null)
{
    <script>
        window.location.href = "Login";
    </script>
    return;
}
<script>
    window.alwaysRefreshOnLoad = @pageModel.AlwaysRefreshOnLoad;
    window.instanceTitle = "@pageModel.InstanceTitle";
    window.comfy_features = {};
    window.checkForUpdatesAutomatically = @doCheckForUpdates;
    @foreach (InstallableFeatures.ComfyInstallableFeature feature in InstallableFeatures.ComfyFeatures.Values)
    {
        <text>
            window.comfy_features["@feature.ID"] = {
                "display_name": "@feature.DisplayName",
                "id": "@feature.ID",
                "url": "@feature.URL",
                "author": "@feature.Author",
                "notice": "@(new HtmlString(Utilities.EscapeJsonString(feature.Notice)))"
            };
        </text>
    }
</script>

<div class="legacy-page">
    <header class="legacy-header">
        <h1 class="translate">SwarmUI</h1>
        <nav class="legacy-nav">
            <a href="#Simple" class="translate">Simple</a>
            <a href="#Text2Image" class="translate">Generate</a>
            <a href="#utilities_tab" class="translate">Utilities</a>
            <a href="#user_tab" class="translate">User</a>
            <a href="#server_tab" class="translate">Server</a>
        </nav>
    </header>
    <div class="tab-content tab-hundred">
        <section class="tab-pane tab-pane-vw legacy-section" id="Simple" role="tabpanel" data-requiredpermission="comfy_dynamic_custom_workflows,simple_tab">
            <h2 class="translate">Simple</h2>
            @await Html.PartialAsync("_Generate/SimpleTab.cshtml", pageModel)
        </section>
        <section class="tab-pane show active legacy-section" id="Text2Image" role="tabpanel">
            <h2 class="translate">Generate</h2>
            @await Html.PartialAsync("_Generate/GenerateTab.cshtml", pageModel)
        </section>
        @WebServer.T2ITabBody
        <section class="tab-pane tab-pane-vw tab-no-scroll legacy-section" id="utilities_tab" role="tabpanel" data-requiredpermission="utilities_tab">
            <h2 class="translate">Utilities</h2>
            @await Html.PartialAsync("_Generate/UtilitiesTab.cshtml", pageModel)
        </section>
        <section class="tab-pane tab-pane-vw tab-no-scroll legacy-section" id="user_tab" role="tabpanel" data-requiredpermission="user_tab">
            <h2 class="translate">User</h2>
            @await Html.PartialAsync("_Generate/UserTab.cshtml", pageModel)
        </section>
        <section class="tab-pane tab-pane-vw tab-no-scroll legacy-section" id="server_tab" role="tabpanel" data-requiredpermission="view_server_tab">
            <h2 class="translate">Server</h2>
            @await Html.PartialAsync("_Generate/ServerTab.cshtml", pageModel)
        </section>
    </div>
</div>

